{
  "name": "@sequelcore/quint-check",
  "version": "0.1.0-alpha.3",
  "license": "Apache-2.0",
  "description": "A Java-free Quint model checker for TypeScript, powered by tla-ts. Experimental.",
  "keywords": ["quint", "tlaplus", "tla-plus", "model-checking", "model-checker", "formal-verification", "formal-methods", "specification", "typescript", "nodejs"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sequelcore/quint-check.git"
  },
  "type": "module",
  "bin": {
    "quint-check": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "demo/*.qnt",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests",
    "test:node": "node --test tests/process.test.ts",
    "conformance": "bun conformance/run.ts",
    "survey": "bun conformance/survey.ts",
    "bench": "bun bench/run.ts",
    "bench:compare": "bun bench/compare.ts",
    "check": "bun run typecheck && bun run test && bun run test:node",
    "prepack": "tsc -p tsconfig.build.json",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "dependencies": {
    "@informalsystems/quint": "0.33.1",
    "tla-ts": "0.0.9"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.10.0",
    "typescript": "7.0.2"
  }
}
